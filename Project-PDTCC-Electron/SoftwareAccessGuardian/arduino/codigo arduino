#include <SPI.h>
#include <MFRC522.h>
#include <Servo.h>

#define SS_PIN 10
#define RST_PIN 9
#define SERVO_PIN 6

MFRC522 rfid(SS_PIN, RST_PIN);
Servo catraca;

void setup() {

  // ==========================================
  // INICIA COMUNICAÇÃO SERIAL
  // ==========================================

  Serial.begin(9600);

  delay(500);

  Serial.println();
  Serial.println("================================");
  Serial.println("       ACCESS GUARDIAN");
  Serial.println("================================");


  // ==========================================
  // INICIA COMUNICAÇÃO SPI
  // ==========================================

  SPI.begin();


  // ==========================================
  // INICIA RC522
  // ==========================================

  rfid.PCD_Init();

  delay(100);


  // ==========================================
  // TESTA RC522
  // ==========================================

  byte versao = rfid.PCD_ReadRegister(rfid.VersionReg);

  Serial.print("Versao RC522: 0x");
  Serial.println(versao, HEX);

  if (versao == 0x00 || versao == 0xFF) {

    Serial.println("ERRO: RC522 NAO DETECTADO");

  } else {

    Serial.println("RC522 DETECTADO");

  }


  // ==========================================
  // INICIA SERVO
  // ==========================================

  catraca.attach(SERVO_PIN);

  // Catraca começa fechada
  catraca.write(0);

  delay(500);

  Serial.println();
  Serial.println("Catraca: FECHADA");
  Serial.println("Leitor RFID pronto.");
  Serial.println("Aproxime um cartao RFID...");
  Serial.println();

}


// ==========================================
// LOOP PRINCIPAL
// ==========================================

void loop() {


  // ==========================================
  // VERIFICA SE EXISTE UM NOVO CARTAO
  // ==========================================

  if (!rfid.PICC_IsNewCardPresent()) {
    return;
  }


  // ==========================================
  // TENTA LER O CARTAO
  // ==========================================

  if (!rfid.PICC_ReadCardSerial()) {

    Serial.println("ERRO: nao foi possivel ler o cartao.");

    return;
  }


  // ==========================================
  // CARTAO DETECTADO
  // ==========================================

  Serial.println("--------------------------------");
  Serial.println("CARTAO DETECTADO!");


  // ==========================================
  // MOSTRA UID
  // ==========================================

  Serial.print("UID:");

  for (byte i = 0; i < rfid.uid.size; i++) {

    if (rfid.uid.uidByte[i] < 0x10) {
      Serial.print("0");
    }

    Serial.print(rfid.uid.uidByte[i], HEX);

  }

  Serial.println();


  // ==========================================
  // MOSTRA TAMANHO DO UID
  // ==========================================

  Serial.print("Tamanho do UID: ");
  Serial.print(rfid.uid.size);
  Serial.println(" bytes");


  // ==========================================
  // FINALIZA COMUNICAÇÃO COM CARTÃO
  // ==========================================

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();


  // ==========================================
  // ABRE A CATRACA
  // ==========================================

  Serial.println("ACESSO_AUTORIZADO");

  Serial.println("Abrindo catraca...");

  catraca.write(90);

  Serial.println("CATRACA_ABERTA");


  // ==========================================
  // AGUARDA 3 SEGUNDOS
  // ==========================================

  delay(3000);


  // ==========================================
  // FECHA A CATRACA
  // ==========================================

  Serial.println("Fechando catraca...");

  catraca.write(0);

  Serial.println("CATRACA_FECHADA");


  // ==========================================
  // VOLTA A AGUARDAR CARTÃO
  // ==========================================

  Serial.println();
  Serial.println("Aproxime outro cartao...");
  Serial.println("--------------------------------");
  Serial.println();

  delay(1000);
}